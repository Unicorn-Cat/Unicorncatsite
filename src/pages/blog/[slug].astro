---
import ArticleLayout from "../../layouts/article.astro";
import { getPublishedBlog } from "../../lib/content";

export async function getStaticPaths() {
    const posts = await getPublishedBlog();
    return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<ArticleLayout
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    kicker="Blog"
    backHref="blog"
    backLabel="All posts"
    people={post.data.authors}
    crossHref={post.data.episode ? `podcast/${post.data.episode}` : undefined}
    crossLabel="Listen to the episode">
    <Content />
</ArticleLayout>
