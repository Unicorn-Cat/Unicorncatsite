---
import Base from "../layouts/base.astro";
import Nav from "../components/Nav.astro";
import FooterPolished from "../components/FooterPolished.astro";

/**
 * Not-found page. Astro emits this as 404.html, which static hosts serve for
 * any unmatched route — so it reuses the polished marketing shell rather than
 * the blog's parchment board: a 404 can be reached from anywhere.
 */
const routes = [
    {
        num: "01",
        title: "Home",
        href: "",
        body: "What we do, how we work, and the engagements we take on.",
    },
    {
        num: "02",
        title: "The Workbench",
        href: "blog",
        body: "Our blog. What we're learning, what worked, and what we broke.",
    },
    {
        num: "03",
        title: "About us",
        href: "about",
        body: "The two people you would actually be working with.",
    },
];
---

<Base title="Page not found — Unicorncat Consulting" noindex>
    <!-- Nav + hero -->
    <div class="hero">
        <Nav />
        <div class="hero-band">
            <div class="container hero-inner">
                <div class="eyebrow eyebrow--dark hero-eyebrow">ERROR 404</div>
                <h1>That page isn't here.</h1>
                <p class="hero-lead">
                    The link is wrong, the page moved, or we took it down. Any of the three is
                    possible.
                </p>
            </div>
        </div>
    </div>

    <!-- Where to go instead -->
    <div class="container section">
        <div class="eyebrow section-eyebrow">WHERE TO GO INSTEAD</div>
        <div class="go-rows">
            {
                routes.map((route, i) => (
                    <a
                        href={route.href}
                        class:list={["uc-row", "go-row", i === routes.length - 1 && "last"]}
                    >
                        <span class="go-num">{route.num}</span>
                        <h3>{route.title}</h3>
                        <p>{route.body}</p>
                        <span class="go-arrow">→</span>
                    </a>
                ))
            }
        </div>
        <p class="go-note">
            If a link we published sent you here, tell us — <a
                href="mailto:alex@unicorncatconsulting.com">alex@unicorncatconsulting.com</a
            >.
        </p>
    </div>

    <FooterPolished />
</Base>

<style>
    .hero {
        background: var(--uc-hero-gradient);
    }
    .hero-band {
        border-top: 1px solid var(--rule-on-dark);
    }
    .hero-inner {
        padding-top: 88px;
        padding-bottom: 80px;
    }
    .hero-eyebrow {
        margin-bottom: 20px;
    }
    h1 {
        font-family: var(--font-display);
        font-weight: var(--fw-black);
        font-size: var(--fs-h1-about);
        line-height: 1.06;
        letter-spacing: var(--tr-display);
        color: #fff;
        margin: 0;
        max-width: 760px;
    }
    .hero-lead {
        font-size: var(--fs-lead);
        line-height: 1.6;
        color: var(--uc-lavender);
        max-width: 560px;
        margin: 28px 0 0 0;
    }

    .section {
        padding-top: var(--section-pad);
        padding-bottom: var(--section-pad);
    }
    .section-eyebrow {
        margin-bottom: 16px;
    }

    .go-rows {
        display: flex;
        flex-direction: column;
    }
    .go-row {
        display: grid;
        grid-template-columns: 80px 300px 1fr 40px;
        gap: 32px;
        padding: 36px 16px;
        margin: 0 -16px;
        border-top: 1px solid var(--uc-border);
        align-items: baseline;
        text-decoration: none;
    }
    .go-row.last {
        border-bottom: 1px solid var(--uc-border);
    }
    .go-num {
        font-size: var(--fs-nav);
        color: var(--uc-text-4);
    }
    .go-row h3 {
        font-family: var(--font-display);
        font-weight: var(--fw-bold);
        font-size: var(--fs-h3-row);
        color: var(--uc-text);
        margin: 0;
        letter-spacing: var(--tr-row);
    }
    .go-row p {
        font-size: var(--fs-body);
        line-height: var(--lh-body);
        color: var(--uc-text-2);
        margin: 0;
    }
    .go-arrow {
        font-size: 18px;
        color: var(--uc-text-4);
        text-align: right;
        transition: color var(--dur-base) var(--ease);
    }
    .go-row:hover .go-arrow {
        color: var(--uc-violet);
    }
    .go-note {
        font-size: var(--fs-nav);
        line-height: 1.6;
        color: var(--uc-text-3);
        margin: 32px 0 0 0;
    }

    @media (max-width: 1023px) {
        h1 {
            font-size: 40px;
        }
    }
    @media (max-width: 767px) {
        h1 {
            font-size: 32px;
        }
        .go-row {
            grid-template-columns: 1fr;
            gap: 8px;
        }
        .go-arrow {
            display: none;
        }
    }
</style>
