---
/**
 * Unfilled image placeholder — no photography has been supplied yet.
 * Pass `src` once a real photo exists; until then a neutral fill with the
 * intent label renders in its place.
 */
type Props = {
    label: string;
    src?: string;
    alt?: string;
    radius?: number;
    board?: boolean;
};

const { label, src, alt = "", radius = 0, board = false } = Astro.props;
const style = radius ? `border-radius:${radius}px; overflow:hidden;` : undefined;
---

{
    src ? (
        <img src={src} alt={alt} style={`${style ?? ""} width:100%; height:100%; object-fit:cover;`} />
    ) : (
        <div class:list={["img-slot", board && "img-slot--board"]} style={style}>
            {label}
        </div>
    )
}
