---
import BaseLayout from "./base.astro";
import { formatDate } from "../lib/content";

type Props = {
    title: string;
    description: string;
    date: Date;
    kicker: string; // "Blog" or "Episode 12"
    backHref: string;
    backLabel: string;
    people: string[];
    crossHref?: string;
    crossLabel?: string;
};

const { title, description, date, kicker, backHref, backLabel, people, crossHref, crossLabel } =
    Astro.props as Props;
---

<BaseLayout title={`${title} | Unicorncat Consulting`}>
    <div
        class="flex justify-between max-w-lg md:max-w-2xl lg:max-w-6xl mx-auto mt-12 pt-20 pb-12 relative border-t-2 border-[#523879]"
        slot="header-content">
        <div class="animate-fadeIn">
            <div class="text-sm uppercase tracking-widest text-[#c4a3ec] mb-4">{kicker}</div>
            <h2
                class="text-3xl md:text-5xl font-bold text-white font-serif leading-tight tracking-tight max-w-3xl mb-6">
                {title}
            </h2>
            <div class="text-lg max-w-2xl text-[#c4a3ec]">{description}</div>
            <div class="text-sm text-[#c4a3ec] mt-6 opacity-80">
                {formatDate(date)} &middot; {people.join(" & ")}
            </div>
        </div>
    </div>

    <div slot="content">
        <article class="content prose-unicorncat max-w-lg md:max-w-2xl lg:max-w-3xl mx-auto">
            <slot />
        </article>

        <div class="max-w-lg md:max-w-2xl lg:max-w-3xl mx-auto mt-16 flex flex-col md:flex-row gap-4 text-base">
            <a href={backHref} class="text-[#5f4085] hover:underline">&larr; {backLabel}</a>
            {crossHref && <a href={crossHref} class="text-[#5f4085] hover:underline">{crossLabel} &rarr;</a>}
        </div>
    </div>
</BaseLayout>

<style is:global>
    .prose-unicorncat h2 {
        font-family: Montserrat, sans-serif;
        font-weight: 700;
        font-size: 1.6rem;
        margin: 2rem 0 0.75rem 0;
        color: #1e293b;
    }
    .prose-unicorncat h3 {
        font-family: Montserrat, sans-serif;
        font-weight: 600;
        font-size: 1.25rem;
        margin: 1.5rem 0 0.5rem 0;
        color: #1e293b;
    }
    .prose-unicorncat p {
        margin-bottom: 1rem;
        line-height: 1.7;
    }
    .prose-unicorncat blockquote {
        border-left: 4px solid #7c55ad;
        padding-left: 1rem;
        color: #475569;
        margin: 1.25rem 0;
    }
    .prose-unicorncat strong {
        color: #2b1c3c;
    }
    .prose-unicorncat ul,
    .prose-unicorncat ol {
        margin: 0 0 1rem 1.5rem;
    }
    .prose-unicorncat ul {
        list-style: disc;
    }
    .prose-unicorncat ol {
        list-style: decimal;
    }
    .prose-unicorncat hr {
        border-color: #e2e8f0;
        margin: 2rem 0;
    }
    .prose-unicorncat a {
        color: #5f4085;
        text-decoration: underline;
    }
</style>
